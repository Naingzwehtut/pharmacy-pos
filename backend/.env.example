SECRET_KEY=change-this-to-a-random-secret
JWT_SECRET_KEY=change-this-to-another-random-secret
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
EXPIRY_WARNING_DAYS=30
# Local business time in minutes from UTC. Myanmar (Asia/Yangon) = 390 (UTC+06:30)
UTC_OFFSET_MINUTES=390

# Investigation files (blood reports, scans): a PRIVATE Supabase Storage bucket.
# Supabase -> Project Settings -> API Keys: use the secret / service_role key (backend only!)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-secret-service-role-key
SUPABASE_BUCKET=investigations
MAX_UPLOAD_MB=10
